# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# --- LLM inference (Phase-0 spike) ---
# When OPENROUTER_API_KEY is set, agents route through OpenRouter (OpenAI-compatible)
# at https://openrouter.ai/api instead of local Ollama. Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model slug used by all agents (read in packages/server/src/rooms/OfficeRoom.ts).
# OpenRouter examples: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, anthropic/claude-sonnet-4.6
# Default: openai/gpt-4o-mini on OpenRouter, llama3.2:latest on local Ollama.
OFFICE_MODEL=

# Colyseus + REST server port (packages/server/src/index.ts). Default: 3000.
PORT=
